{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules scripts/run-tests.cjs --config jest.config.cjs",
    "test:integration": "node --experimental-vm-modules scripts/run-tests.cjs --config jest.integration.config.cjs",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-db.cjs",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "auth:provision": "node -r dotenv/config -r ts-node/register scripts/provision-account.ts",
    "local:token": "node scripts/local-token.cjs",
    "local:setup": "node scripts/local-setup.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "@types/express": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "nodemailer": "^10.1.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "@types/nodemailer": "^8.0.2"
  }
}
