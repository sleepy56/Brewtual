# Template for Vercel Environment Variables; fill in Vercel's project settings.
# This is not automatically loaded by the app or a substitute for a deployment.
NODE_ENV=production
AUTH_MODE=jwt
# Use your real pooled Neon URL. Keep this server-only.
DATABASE_URL=
# Use your real unpooled Neon URL for Prisma CLI migration commands.
DATABASE_URL_UNPOOLED=
# First-party password login and revocable JWT sessions.
# Requires a random secret of at least 32 characters. Keep it backend-only.
JWT_SECRET=
JWT_ISSUER=pair-habits
JWT_AUDIENCE=pair-habits-api
# Resend SMTP uses smtp.resend.com:465, username "resend", and an API key as password.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender address must belong to a domain verified with your email provider.
SMTP_FROM=
# Exact HTTPS origin of this Vercel project, without trailing slash.
APP_WEB_URL=
# Exact same origin; native apps do not need CORS.
CORS_ORIGINS=
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=30000
# Do not deploy LOCAL_AUTH_SECRET or AUTH_MODE=local.
# Vercel supplies PORT; leave it unset in the project settings.
