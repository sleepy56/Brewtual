NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://pair_app:pair_app_local@localhost:5433/pair_habits?schema=public
# Use an unpooled Neon connection for migrations; for local Postgres both are the same.
DATABASE_URL_UNPOOLED=postgresql://pair_app:pair_app_local@localhost:5433/pair_habits?schema=public
# Integration tests use disposable local schemas, never the real Neon app database.
TEST_DATABASE_URL=postgresql://pair_app:pair_app_local@localhost:5433/pair_habits?schema=public
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Local tokens are only accepted in development/test. Generate your own secret.
AUTH_MODE=local
LOCAL_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# For managed auth, set AUTH_MODE=supabase and your project URL instead.
SUPABASE_URL=
