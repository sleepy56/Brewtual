{
  "name": "pair-habits",
  "private": true,
  "workspaces": ["backend", "mobile"],
  "engines": { "node": ">=24.9.0" },
  "overrides": { "deepmerge-ts": "8.0.2" },
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "mobile": "npm run start --workspace mobile",
    "web": "npm run web --workspace mobile",
    "web:build": "npm run export --workspace mobile",
    "mobile:web": "npm run web --workspace mobile",
    "mobile:test": "npm run test --workspace mobile",
    "mobile:typecheck": "npm run typecheck --workspace mobile",
    "mobile:export": "npm run export --workspace mobile",
    "build": "npm run build --workspace backend",
    "test": "npm run test --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "typecheck": "npm run typecheck --workspace backend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:check": "npm run db:check --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "auth:provision": "npm run auth:provision --workspace backend --",
    "local:token": "npm run local:token --workspace backend --",
    "local:setup": "npm run local:setup --workspace backend"
  }
}
