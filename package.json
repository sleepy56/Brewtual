{
  "name": "pair-habits",
  "private": true,
  "type": "module",
  "workspaces": ["mobile"],
  "engines": { "node": "24.x" },
  "overrides": { "deepmerge-ts": "8.0.2" },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "mobile": "npm run start --workspace mobile",
    "web": "next dev",
    "web:build": "npm run build",
    "mobile:web": "npm run web --workspace mobile",
    "mobile:test": "npm run test --workspace mobile",
    "mobile:typecheck": "npm run typecheck --workspace mobile",
    "mobile:export": "npm run export --workspace mobile",
    "build": "prisma generate && next build",
    "build:vercel": "npm run build",
    "test:vercel": "npm run build && node --test test/vercel-routing.test.cjs",
    "test": "node scripts/run-tests.cjs --config jest.config.cjs && node --test test/web-client.test.cjs test/web-planner.test.cjs",
    "test:integration": "node scripts/run-tests.cjs --config jest.integration.config.cjs",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-db.cjs",
    "db:migrate": "prisma migrate deploy",
    "auth:provision": "tsx scripts/provision-account.ts",
    "local:token": "node scripts/local-token.cjs",
    "local:setup": "node scripts/local-setup.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^16.6.1",
    "jose": "^5.10.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
