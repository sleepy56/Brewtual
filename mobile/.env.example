# Configuration for the planned React Native + Expo app (UI not scaffolded yet).
# On a physical phone, replace 192.168.1.100 with your computer's LAN IP.
# For deployed builds, replace this with the HTTPS API origin ending in /api/v1.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001/api/v1
# Public authentication client settings; obtain these from the auth project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put DATABASE_URL, migration credentials, or LOCAL_AUTH_SECRET here.
