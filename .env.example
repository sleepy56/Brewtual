# Copy to .env at the repository root. Next.js and Prisma CLI use this file.
NODE_ENV=development
DATABASE_URL=postgresql://pair_app:pair_app_local@localhost:5433/pair_habits?schema=public
DATABASE_URL_UNPOOLED=postgresql://pair_app:pair_app_local@localhost:5433/pair_habits?schema=public
# Local integration tests create and remove an isolated schema, never use Neon here.
TEST_DATABASE_URL=postgresql://pair_app:pair_app_local@localhost:5433/pair_habits?schema=public
AUTH_MODE=jwt
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=pair-habits
JWT_AUDIENCE=pair-habits-api
APP_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=30000
# Local signup works immediately with no emails. Set true after verifying
# sleepytanuki.dev in Resend and configuring the server-side SMTP settings below.
REQUIRE_EMAIL_VERIFICATION=false
# Resend SMTP: https://resend.com/docs/send-with-smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# Your Resend sending API key goes here (re_...). Keep it out of Git.
SMTP_PASSWORD=
SMTP_FROM="Brewtual <hello@sleepytanuki.dev>"
# Verification links use APP_WEB_URL above; use the deployed HTTPS app origin in production.
# Development/test only: opt into AUTH_MODE=local and set a separate strong key.
LOCAL_AUTH_SECRET=
