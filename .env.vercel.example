# Set these in Vercel project Environment Variables, not in browser code.
AUTH_MODE=jwt
DATABASE_URL=
DATABASE_URL_UNPOOLED=
JWT_SECRET=
JWT_ISSUER=pair-habits
JWT_AUDIENCE=pair-habits-api
# Keep both origins in sync with the domain opened in the browser.
# Updating this template does not update Vercel; save the values there and redeploy.
APP_WEB_URL=https://brewtual.vercel.app
CORS_ORIGINS=https://brewtual.vercel.app
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=30000
# Optional; omitted defaults to false. Signup sends no email in this mode.
REQUIRE_EMAIL_VERIFICATION=false
# Configure these before setting REQUIRE_EMAIL_VERIFICATION=true.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
